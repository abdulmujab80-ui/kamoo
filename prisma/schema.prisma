generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String           @id @default(uuid())
  nama           String
  email          String           @unique
  password       String
  role           Role
  aktif          Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  fotoProfil     String?
  fotoProfilPath String?
  approvals      Approval[]
  audit          AuditLog[]
  loker          Loker?
  lokerShares    LokerShare[]
  pengajuanSurat PengajuanSurat[]
  reimburse      Reimburse[]
}

model SuratMasuk {
  id           String      @id @default(uuid())
  nomorSurat   String
  tanggalSurat DateTime
  asal         String
  perihal      String
  fileUrl      String?
  status       StatusSurat @default(DIAJUKAN)
  createdAt    DateTime    @default(now())
}

model PengajuanSurat {
  id             String       @id @default(uuid())
  userId         String
  jenis          String
  tujuan         String
  keperluan      String
  tanggalMulai   DateTime?
  tanggalSelesai DateTime?
  fileUrl        String?
  status         StatusSurat  @default(DIAJUKAN)
  createdAt      DateTime     @default(now())
  isiSurat       String?
  kodeJenis      String?
  kodeNomor      String?
  user           User         @relation(fields: [userId], references: [id])
  suratKeluar    SuratKeluar?

  @@index([userId])
  @@index([status])
}

model SuratKeluar {
  id           String          @id @default(uuid())
  nomorSurat   String          @unique
  tujuan       String
  perihal      String
  tanggalSurat DateTime
  fileUrl      String?
  status       StatusSurat     @default(DRAFT)
  createdAt    DateTime        @default(now())
  isiSurat     String
  pengajuanId  String?         @unique
  kodeJenis    String?
  kodeNomor    String?
  pengajuan    PengajuanSurat? @relation(fields: [pengajuanId], references: [id])

  @@index([status])
}

model NomorSurat {
  id        String   @id @default(uuid())
  tahun     Int      @unique
  createdAt DateTime @default(now())
  nomorUrut Int      @default(0)
}

model Reimburse {
  id         String          @id @default(uuid())
  userId     String
  keterangan String
  jumlah     Float
  buktiUrl   String?
  createdAt  DateTime        @default(now())
  catatan    String?
  updatedAt  DateTime        @updatedAt
  status     StatusReimburse @default(MENUNGGU)
  keuangan   Keuangan?
  user       User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Keuangan {
  id          String         @id @default(uuid())
  jenis       JenisTransaksi
  keterangan  String
  jumlah      Float
  tanggal     DateTime
  buktiUrl    String?
  createdAt   DateTime       @default(now())
  kategori    String
  pihak       String?
  reimburseId String?        @unique
  updatedAt   DateTime       @updatedAt
  reimburse   Reimburse?     @relation(fields: [reimburseId], references: [id])

  @@index([jenis])
  @@index([kategori])
  @@index([tanggal])
}

model Jadwal {
  id             String   @id @default(uuid())
  judul          String
  deskripsi      String?
  lokasi         String?
  mulai          DateTime
  selesai        DateTime
  createdAt      DateTime @default(now())
  dokumentasiUrl String?

  @@index([mulai])
}

model Dokumen {
  id        String   @id @default(uuid())
  nama      String
  kategori  String
  fileUrl   String
  createdAt DateTime @default(now())

  @@index([kategori])
}

model Loker {
  id        String        @id @default(uuid())
  userId    String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id])
  files     LokerFile[]
  folders   LokerFolder[]
  shares    LokerShare[]

  @@index([userId])
}

model LokerFolder {
  id              String           @id @default(uuid())
  lokerId         String
  parentId        String?
  nama            String
  storageProvider StorageProvider?
  storageId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  files           LokerFile[]
  loker           Loker            @relation(fields: [lokerId], references: [id], onDelete: Cascade)
  parent          LokerFolder?     @relation("LokerFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        LokerFolder[]    @relation("LokerFolderTree")

  @@index([lokerId])
  @@index([parentId])
}

model LokerFile {
  id              String          @id @default(uuid())
  lokerId         String
  folderId        String?
  nama            String
  storageProvider StorageProvider @default(GOOGLE_DRIVE)
  storageId       String          @unique
  storageUrl      String?
  ukuran          Int?
  mimeType        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  folder          LokerFolder?    @relation(fields: [folderId], references: [id])
  loker           Loker           @relation(fields: [lokerId], references: [id], onDelete: Cascade)

  @@index([lokerId])
  @@index([folderId])
  @@index([createdAt])
  @@index([updatedAt])
}

model LokerShare {
  id         String          @id @default(uuid())
  lokerId    String
  userId     String
  permission LokerPermission
  createdAt  DateTime        @default(now())
  loker      Loker           @relation(fields: [lokerId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lokerId, userId])
  @@index([userId])
}

model Approval {
  id        String         @id @default(uuid())
  modul     String
  dataId    String
  status    StatusApproval @default(MENUNGGU)
  catatan   String?
  createdAt DateTime       @default(now())
  userId    String
  user      User           @relation(fields: [userId], references: [id])

  @@index([modul, dataId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  aktivitas String
  createdAt DateTime @default(now())
  dataId    String?
  modul     String?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([modul, dataId])
}

enum Role {
  SUPERADMIN
  ADMIN_SEKRETARIS
  ADMIN_BENDAHARA
  PENGURUS
  ANGGOTA
}

enum StatusSurat {
  DRAFT
  DIAJUKAN
  DIPROSES
  DISETUJUI
  DITOLAK
  SELESAI
}

enum StatusApproval {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum StatusReimburse {
  MENUNGGU
  DISETUJUI
  DITOLAK
  DIBAYAR
}

enum JenisTransaksi {
  MASUK
  KELUAR
}

enum LokerPermission {
  VIEWER
  EDITOR
}

enum StorageProvider {
  GOOGLE_DRIVE
}
